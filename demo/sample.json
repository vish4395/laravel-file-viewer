{
    "package": "vish4395/laravel-file-viewer",
    "version": "1.1.0",
    "description": "Laravel File Viewer demo JSON file",
    "supported_types": [
        "image", "video", "audio",
        "pdf", "docx", "xlsx", "pptx",
        "odt", "ods", "odp",
        "csv", "txt", "json"
    ],
    "config": {
        "default_disk": "public",
        "google_viewer_fallback": false,
        "toolbar": {
            "download": true,
            "open_in_new_tab": true,
            "copy_link": true,
            "fullscreen": true
        }
    },
    "author": {
        "name": "Vishal Sharma",
        "github": "https://github.com/vish4395"
    }
}
